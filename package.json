{
  "name": "imperial-tours",
  "version": "1.0.0",
  "private": true,
  "description": "Imperial Tours — luxury Egypt travel platform. Next.js App Router + Payload CMS + MongoDB.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/run.ts",
    "test:pricing": "node --experimental-strip-types tests/pricing.test.ts",
    "test": "npm run test:pricing && npm run test:rental && npm run test:whatsapp && npm run test:access && npm run test:i18n && npm run test:twmerge && npm run test:links && npm run test:fallback",
    "test:whatsapp": "node --experimental-strip-types tests/whatsapp.test.ts",
    "test:access": "node --experimental-strip-types tests/access.test.ts",
    "test:i18n": "node --experimental-strip-types tests/i18n-namespaces.test.ts",
    "media:restore": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/restore-media.ts",
    "media:migrate-uploadthing": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/migrate-media-to-uploadthing.ts",
    "test:twmerge": "node --experimental-strip-types tests/tailwind-merge.test.ts",
    "test:links": "node --experimental-strip-types tests/links.test.ts",
    "demo:offers": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/demo-offers.ts",
    "services:backfill-locales": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/backfill-localized-rows.ts",
    "services:backfill-transfers": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/backfill-transfers-service.ts",
    "tours:backfill-price": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/backfill-price-from.ts",
    "transfers:seed-airports": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/seed-airports.ts",
    "hotels:backfill-price": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/backfill-hotel-price.ts",
    "currencies:set": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/set-currencies.ts",
    "contact:seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/seed-contact.ts",
    "demo:bicycles": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/seed/demo-bicycles.ts",
    "test:rental": "node --experimental-strip-types tests/rental-pricing.test.ts",
    "test:fallback": "node --experimental-strip-types tests/fallback-data.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-mongodb": "^3.89.0",
    "@payloadcms/email-nodemailer": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-uploadthing": "^3.89.0",
    "@payloadcms/ui": "^3.89.0",
    "clsx": "^2.1.1",
    "graphql": "^16.9.0",
    "next": "15.4.11",
    "next-intl": "^4.3.4",
    "payload": "^3.89.0",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^2.5.4",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  }
}

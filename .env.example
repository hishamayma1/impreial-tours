# ---------------------------------------------------------------------------
# Database
# Local:  mongodb://127.0.0.1:27017/imperial-tours
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/imperial-tours?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
DATABASE_URI=mongodb://127.0.0.1:27017/imperial-tours

# 32+ random chars. Rotating this invalidates every admin session.
PAYLOAD_SECRET=change-me-to-a-long-random-string-please

# Public origin, used for media URLs, SEO canonicals and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media storage (UploadThing) — required, including in local dev.
# Uploads are read-only on Vercel's serverless filesystem, so Media files are
# stored on UploadThing rather than in public/media.
#   1. Create an app at https://uploadthing.com/dashboard
#   2. Copy its API key (Settings → API Keys) here and into Vercel's env vars
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=

# Admin account
# No seeded admin: with an empty users collection Payload serves its own
# "create first user" screen at /admin, and whoever signs up there becomes the
# first administrator.

# Optional: on-demand revalidation secret for external webhooks
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Email (Payload admin password resets / verification)
# Gmail requires a 16-character App Password, NOT your account password:
#   1. Enable 2-Step Verification on the Google account
#   2. Generate one at https://myaccount.google.com/apppasswords
#   3. Paste it into SMTP_PASS below (no spaces)
# Leave SMTP_PASS empty and emails are written to the server log instead of sent.
# Set EMAIL_PREVIEW=1 as well to route them through a throwaway ethereal.email inbox
# and get a clickable preview URL. That opens a test account over the network on every
# server boot, so leave it off unless you are actually testing an email.
EMAIL_PREVIEW=
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hishamayman2003@gmail.com
SMTP_PASS=
SMTP_FROM_ADDRESS=hishamayman2003@gmail.com
SMTP_FROM_NAME=Imperial Tours

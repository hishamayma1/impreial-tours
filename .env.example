# ---------------------------------------------------------------------------
# Database
# Local:  mongodb://127.0.0.1:27017/imperial-tours
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/imperial-tours?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
DATABASE_URI=mongodb://127.0.0.1:27017/imperial-tours

# 32+ random chars. Rotating this invalidates every admin session.
PAYLOAD_SECRET=change-me-to-a-long-random-string-please

# Public origin, used for media URLs, SEO canonicals and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Seed script credentials (npm run seed)
SEED_ADMIN_EMAIL=admin@imperialtours.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional: on-demand revalidation secret for external webhooks
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Email (Payload admin password resets / verification)
# Gmail requires a 16-character App Password, NOT your account password:
#   1. Enable 2-Step Verification on the Google account
#   2. Generate one at https://myaccount.google.com/apppasswords
#   3. Paste it into SMTP_PASS below (no spaces)
# Leave SMTP_PASS empty to keep using the Ethereal preview transport in dev.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hishamayman2003@gmail.com
SMTP_PASS=
SMTP_FROM_ADDRESS=hishamayman2003@gmail.com
SMTP_FROM_NAME=Imperial Tours
